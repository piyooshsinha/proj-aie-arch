# --- Model providers -------------------------------------------------------
# Which provider serves the "default" route: "anthropic" or "local".
# With no Anthropic credentials present, this falls back to local automatically.
AIE_PRIMARY=anthropic

# Anthropic API. The SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login`
# profile -- the platform never handles a key itself, it just lets the SDK resolve one.
# ANTHROPIC_API_KEY=sk-ant-...
AIE_ANTHROPIC_MODEL=claude-opus-5
# Thinking depth / token spend: low | medium | high | xhigh | max. Default is high.
# AIE_EFFORT=medium

# Local LLM: any OpenAI-compatible server (Ollama, llama.cpp, vLLM, LM Studio).
AIE_LOCAL_BASE_URL=http://localhost:11434/v1
AIE_LOCAL_MODEL=llama3.1:8b

# --- Cache -----------------------------------------------------------------
# user   = never shared between users (default, safest)
# tenant = shared within a tenant -- only safe if retrieval is not user-permissioned
# global = shared by everyone -- only for content with no access control at all
AIE_CACHE_SCOPE=user
AIE_CACHE_TTL_S=300
AIE_CACHE_ENABLED=true

# --- Pipeline --------------------------------------------------------------
AIE_TOP_K=4
AIE_MAX_ITERATIONS=2
